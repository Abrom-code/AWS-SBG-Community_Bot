# Required: Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Required: Telegram Admin Staff Group Chat ID for feedback routing
ADMIN_GROUP_CHAT_ID=-1001234567890

# Required: Comma-separated Telegram User IDs with admin access
ADMIN_USER_IDS=123456789,987654321

# Required for Vercel / Cloud: Supabase PostgreSQL Connection String
# (If left unset locally, the bot defaults to local SQLite bot.db)
DATABASE_URL=postgresql://postgres.[project-ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres


# Optional: Timezone configuration (Default: East Africa Time / EAT, UTC+3)
BOT_TIMEZONE_OFFSET_HOURS=3
BOT_TIMEZONE_NAME=EAT

# Webhook activation url
# https://api.telegram.org/bot<YOUR_BOT_TOKEN>/setWebhook?url=https://<YOUR_VERCEL_DOMAIN>/api/webhook


