TELEGRAM_BOT_TOKEN=telegram_bot_token_here
ADMIN_GROUP_CHAT_ID=telegram_group_chat_id_here
WEBHOOK_URL=deploy_url_here
WEBHOOK_SECRET=deploy_secret_here
PORT=8443

# Optional: Upstash Redis for persistent storage (required on Vercel Serverless)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here