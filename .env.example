TELEGRAM_BOT_TOKEN=telegram_bot_token_here
ADMIN_GROUP_CHAT_ID=telegram_group_chat_id_here
# Optional: Comma-separated list of Telegram user IDs with administrative privileges
ADMIN_USER_IDS=123456789,987654321
WEBHOOK_URL=deploy_url_here
WEBHOOK_SECRET=deploy_secret_here
PORT=8443

# Optional: PostgreSQL Database URL (e.g. Supabase, Neon, Railway, AWS RDS)
# If left unset, the bot automatically uses local SQLite (bot.db) with zero setup!
DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
SQLITE_DB_PATH=bot.db

